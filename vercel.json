{
  "rewrites": [
    {
      "source": "/social.json",
      "destination": "/api/social"
    },
    {
      "source": "/make",
      "destination": "/make.html"
    }
  ],
  "functions": {
    "api/manifest.js": {
      "includeFiles": "icons/choices/**"
    },
    "api/socials.js": {
      "maxDuration": 60
    }
  }
}
